def first_non_repeating(text):
    count = {}
    for char in text:
        if char in count:
            count[char] += 1
        else:
            count[char] = 1
    for char in text:
        if count[char] == 1:
            return char
    return None
text = "aabbcde"
print(first_non_repeating(text))
